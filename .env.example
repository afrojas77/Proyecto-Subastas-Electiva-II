NODE_ENV=development
PORT=3000
PERSISTENCE=sqlserver

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=SubastasDB
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=15000

# Base académica autorizada para integración. La suite solo limpia sus propios IDs.
DB_TEST_DATABASE=SubastasDB
# Habilitar únicamente al ejecutar conscientemente la suite de integración.
RUN_SQLSERVER_INTEGRATION=false

# Use un secreto aleatorio de al menos 32 caracteres. Nunca versione el real.
AUTH_TOKEN_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Tiempo de vida del token de acceso en segundos (ejemplo: una hora).
AUTH_TOKEN_EXPIRES_IN_SECONDS=3600

# Exclusivo para el webhook simulado de desarrollo. No usar en producción.
SIMULATED_PAYMENT_WEBHOOK_SECRET=replace_with_a_local_development_secret
